/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests (DIA with Spectronaut)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple test.

    Use as follows:
        nextflow run bigbio/quantms -profile test_dia_spectronaut,<docker/singularity> -stub-run [--outdir <OUTDIR>]

    Note: This test MUST run in stub mode (-stub-run flag) since Spectronaut is proprietary software.
          It validates workflow logic and parameter handling without requiring a license or binary.
          CI automatically uses stub mode for this profile.

------------------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '6.GB',
        time: '48.h'
    ]
}

params {
    config_profile_name        = 'Test profile for DIA (Spectronaut)'
    config_profile_description = 'Minimal test dataset to check Spectronaut DIA workflow in stub mode. Validates distributed batch processing logic without requiring proprietary binary.'

    outdir = './results_dia_spectronaut'

    // Input data (reuse DIA-NN test dataset)
    input = 'https://raw.githubusercontent.com/bigbio/quantms-test-datasets/quantms/testdata/dia_ci/PXD026600.sdrf.tsv'
    database = 'https://raw.githubusercontent.com/bigbio/quantms-test-datasets/quantms/testdata/dia_ci/REF_EColi_K12_UPS1_combined.fasta'
    
    // DIA tool selection
    dia_tool = 'spectronaut'
    
    // Spectronaut-specific parameters
    spectronaut_batch_size = 2  // Small batch size for quick testing
    // spectronaut_license_key - Not needed in stub mode
    // spectronaut_settings_prop - Optional, not used in stub mode
    // spectronaut_settings_json - Optional, not used in stub mode
    
    // DIA parameters
    min_pr_mz = 350
    max_pr_mz = 950
    min_fr_mz = 500
    max_fr_mz = 1500
    min_peptide_length = 15
    max_peptide_length = 30
    max_precursor_charge = 3
    allowed_missed_cleavages = 1
    skip_post_msstats = true  // Skip MSstats since Spectronaut reports need conversion
    publish_dir_mode = 'symlink'
    max_mods = 2
}

process {
    // thermorawfileparser
    withName: 'BIGBIO_QUANTMS:QUANTMS:FILE_PREPARATION:THERMORAWFILEPARSER' {
        publishDir  = [path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" }, pattern: "*.log" ]
    }
}
