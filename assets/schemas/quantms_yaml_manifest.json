{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "quantms YAML Manifest Schema",
    "description": "Schema for quantms YAML input manifests (current specification). Defines experiment metadata, samples, multiplex mixtures, runs, and structured modification annotations.",
    "type": "object",
    "required": ["experiment", "samples", "mixtures", "runs"],
    "additionalProperties": false,
    "definitions": {
        "ontology_id": {
            "type": "string",
            "pattern": "^(UNIMOD|MOD):[0-9]+$",
            "description": "Ontology identifier in UNIMOD:<number> or MOD:<number> format, for example 'UNIMOD:21' or 'MOD:00696'."
        },
        "residues": {
            "description": "Target amino-acid residue subset used in this dataset (e.g. 'M', ['S', 'T', 'Y']). Terminal specificity must be expressed via term_specificity instead of using N-term/C-term as residues.",
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string"
                    }
                },
                {
                    "type": "null"
                }
            ]
        },
        "term_specificity": {
            "type": "string",
            "enum": ["none", "n-term", "c-term", "protein-n-term", "protein-c-term"],
            "description": "Dataset-specific term specificity restriction. Optional; defaults semantically to 'none'."
        },
        "modification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Optional identifier for this modification entry."
                },
                "profile": {
                    "type": "string",
                    "description": "Optional modification profile name. If omitted, the entry belongs to the implicit default profile."
                },
                "kind": {
                    "type": "string",
                    "enum": ["ontology", "custom"],
                    "default": "ontology",
                    "description": "Modification type. Ontology-backed modifications can be identified by ontology_id or name; custom modifications are user-defined."
                },
                "name": {
                    "type": "string",
                    "description": "Human-readable modification name. Required for custom modifications; optional for ontology-backed modifications when ontology_id is provided."
                },
                "ontology_id": {
                    "$ref": "#/definitions/ontology_id"
                },
                "accession": {
                    "$ref": "#/definitions/ontology_id",
                    "description": "Deprecated alias for ontology_id."
                },
                "residues": {
                    "$ref": "#/definitions/residues"
                },
                "mode": {
                    "type": "string",
                    "enum": ["fixed", "variable"],
                    "description": "Modification mode: fixed for static modifications, variable for optional modifications."
                },
                "mass_shift": {
                    "type": "number",
                    "description": "Optional user-specified mass shift in Daltons. For ontology-backed modifications, supplied values must agree with curated ontology expectations when known."
                },
                "formula": {
                    "type": "string",
                    "description": "Optional user-specified chemical formula. For ontology-backed modifications, supplied values must agree with curated ontology expectations when known."
                },
                "term_specificity": {
                    "$ref": "#/definitions/term_specificity"
                },
                "term_spec": {
                    "$ref": "#/definitions/term_specificity",
                    "description": "Deprecated alias for term_specificity."
                },
                "binary_group": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Optional Comet binary modification group number."
                },
                "min_occurrences": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Minimum number of times this modification must occur on a peptide."
                },
                "max_occurrences": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Maximum number of times this modification may occur on a peptide."
                },
                "distance_from_terminus": {
                    "type": "integer",
                    "description": "Maximum distance from the relevant terminus (-1 = unrestricted)."
                },
                "required": {
                    "type": "boolean",
                    "description": "Whether this modification must be present."
                },
                "neutral_loss": {
                    "type": "number",
                    "description": "Optional neutral loss mass annotation."
                },
                "localize_mass_shift": {
                    "type": "boolean",
                    "description": "Optional localization hint used by tools such as Sage."
                },
                "label_mass_shift": {
                    "type": "number",
                    "description": "Optional label mass-shift annotation used by tools such as DIA-NN."
                },
                "custom_mod_code": {
                    "type": "string",
                    "description": "Optional tool-specific short code, for example for MS-GF+."
                }
            },
            "allOf": [
                {
                    "required": ["mode"]
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "custom"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "required": ["name", "mass_shift"],
                        "anyOf": [
                            {
                                "required": ["residues"]
                            },
                            {
                                "required": ["term_specificity"]
                            },
                            {
                                "required": ["term_spec"]
                            }
                        ]
                    },
                    "else": {
                        "anyOf": [
                            {
                                "required": ["name"]
                            },
                            {
                                "required": ["ontology_id"]
                            },
                            {
                                "required": ["accession"]
                            }
                        ]
                    }
                }
            ]
        },
        "sample_metadata": {
            "type": "object",
            "description": "Structured SDRF-derived sample metadata fields keyed by their normalized names.",
            "additionalProperties": true
        }
    },
    "properties": {
        "metadata": {
            "title": "Manifest Metadata",
            "description": "Optional manifest-level metadata including schema version and ontology provenance information.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "schema_version": {
                    "type": "string",
                    "description": "Version of the quantms YAML manifest schema that this file was created/validated against."
                },
                "ontology_versions": {
                    "type": "object",
                    "description": "Map of ontology names to their versions used for validation (e.g., 'psi-ms': '4.1.135').",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            }
        },
        "experiment": {
            "title": "Experiment Configuration",
            "description": "Top-level experiment settings including MS acquisition method, enzyme, quantification method, and structured experiment-level modifications.",
            "type": "object",
            "required": ["acquisition_method", "enzyme"],
            "additionalProperties": false,
            "properties": {
                "acquisition_method": {
                    "type": "string",
                    "enum": ["DDA", "DIA"],
                    "description": "Mass spectrometry acquisition method: data-dependent (DDA) or data-independent (DIA).",
                    "x-controlled-vocabulary": "quantms_acquisition_methods"
                },
                "quantification_method": {
                    "type": "string",
                    "enum": ["LFQ", "TMT", "iTRAQ", "SILAC"],
                    "description": "Quantification method: label-free (LFQ), isobaric (TMT, iTRAQ), or metabolic labeling (SILAC).",
                    "x-controlled-vocabulary": "quantms_quantification_methods"
                },
                "enzyme": {
                    "type": "string",
                    "description": "Protease used for digestion (e.g. Trypsin, Chymotrypsin, Pepsin). Must be a recognized protease name.",
                    "x-controlled-vocabulary": "MS:1001045",
                    "x-cv-source": "PSI-MS"
                },
                "dissociation_method": {
                    "type": "string",
                    "description": "Fragmentation / dissociation method used (e.g. HCD, CID, ETD).",
                    "x-controlled-vocabulary": "MS:1000044",
                    "x-cv-source": "PSI-MS",
                    "x-valid-values": [
                        "HCD",
                        "CID",
                        "ETD",
                        "PSD",
                        "ECD",
                        "IRMPD",
                        "PQD",
                        "UVPD",
                        "SID",
                        "NETD",
                        "SURMAC",
                        "CX"
                    ]
                },
                "modifications": {
                    "type": "array",
                    "description": "Deprecated alias for the top-level modifications collection. Use the top-level modifications field instead."
                },
                "modification_profile": {
                    "type": "string",
                    "description": "Deprecated experiment-level default profile selector. Runs should use run.modification_profile when multiple profiles exist."
                },
                "custom_mod_profile": {
                    "type": "string",
                    "description": "Deprecated alias for experiment.modification_profile."
                },
                "precursor_mass_tolerance": {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?\\s*(ppm|Da|mDa)$",
                    "description": "Precursor mass tolerance with unit (e.g. '10 ppm', '5 Da')."
                },
                "fragment_mass_tolerance": {
                    "type": "string",
                    "pattern": "^[0-9]+(\\.[0-9]+)?\\s*(ppm|Da|mDa)$",
                    "description": "Fragment mass tolerance with unit (e.g. '0.02 Da', '20 ppm')."
                }
            }
        },
        "samples": {
            "title": "Biological Samples",
            "description": "List of unique biological samples in the experiment.",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["id"],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique sample identifier."
                    },
                    "organism": {
                        "type": "string",
                        "description": "Organism or species (e.g. 'homo sapiens', 'mus musculus').",
                        "x-ontology": "NCBI:Taxonomy",
                        "x-cv-source": "NCBI Organism Taxonomy"
                    },
                    "organism_part": {
                        "type": "string",
                        "description": "Tissue or organ source (e.g. 'liver', 'brain', 'cell line').",
                        "x-ontology": "UBERON:Uberon anatomy",
                        "x-cv-source": "Cell and Tissue Ontology"
                    },
                    "condition": {
                        "type": "string",
                        "description": "Experimental condition or treatment."
                    },
                    "biological_replicate": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Biological replicate number."
                    },
                    "technical_replicate": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Technical replicate number."
                    },
                    "disease": {
                        "type": "string",
                        "description": "Disease or disease state if applicable.",
                        "x-ontology": "DOID:Disease",
                        "x-cv-source": "Disease Ontology"
                    },
                    "cell_type": {
                        "type": "string",
                        "description": "Cell type if applicable.",
                        "x-ontology": "CL:CellType",
                        "x-cv-source": "Cell Ontology"
                    },
                    "characteristics": {
                        "$ref": "#/definitions/sample_metadata"
                    },
                    "factor_values": {
                        "$ref": "#/definitions/sample_metadata"
                    },
                    "additional_metadata": {
                        "type": "object",
                        "description": "Free-form user-specific metadata fields that do not overlap with explicit sample properties or SDRF-derived characteristics/factor values."
                    }
                }
            }
        },
        "mixtures": {
            "title": "Multiplex Mixtures",
            "description": "Groups of samples multiplexed together via isobaric labels (TMT, iTRAQ) or relative quantification labels (SILAC). Empty array allowed for LFQ experiments.",
            "type": "array",
            "minItems": 0,
            "items": {
                "type": "object",
                "required": ["id", "channels"],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique mixture identifier."
                    },
                    "description": {
                        "type": "string",
                        "description": "Human-readable description of the mixture."
                    },
                    "channels": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": {
                            "type": "string"
                        },
                        "description": "Mapping of channel names / labels to sample IDs.",
                        "x-channel-types": {
                            "TMT": "TMT2, TMT6, TMT10, TMT11, TMT16, TMT18",
                            "iTRAQ": "iTRAQ4, iTRAQ8",
                            "SILAC": "2-plex (light/heavy), 3-plex (light/medium/heavy)"
                        }
                    }
                }
            }
        },
        "runs": {
            "title": "Raw Data Runs",
            "description": "List of raw spectrometry files (runs) with their metadata and mixture / fraction assignments.",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["file", "mixture"],
                "additionalProperties": false,
                "properties": {
                    "file": {
                        "type": "string",
                        "description": "Path or URI to the raw spectrometry file."
                    },
                    "fraction": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Fraction number for multi-fraction runs."
                    },
                    "mixture": {
                        "oneOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "description": "Mixture ID this run belongs to. Null for LFQ runs."
                    },
                    "instrument": {
                        "type": "string",
                        "description": "Instrument type or model used.",
                        "x-ontology": "MS:1000031",
                        "x-cv-source": "PSI-MS Instruments"
                    },
                    "modification_profile": {
                        "type": "string",
                        "description": "Reference to a modification profile name present on top-level modification entries via their profile field."
                    },
                    "custom_mod_profile": {
                        "type": "string",
                        "description": "Deprecated alias for modification_profile."
                    }
                }
            }
        },
        "modifications": {
            "title": "Modification Definitions",
            "description": "Canonical merged modification collection. Each entry defines one modification and can optionally belong to a named profile via the profile field. If only one profile exists, it is used by default for all runs; otherwise runs should select a profile.",
            "type": "array",
            "items": {
                "$ref": "#/definitions/modification"
            }
        },
        "mod_profiles": {
            "title": "Modification Definitions",
            "description": "Deprecated alias for the top-level modifications collection.",
            "type": "array",
            "items": {
                "$ref": "#/definitions/modification"
            }
        }
    }
}
